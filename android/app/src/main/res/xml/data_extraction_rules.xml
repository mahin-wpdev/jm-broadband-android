<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keystore-encrypted preferences cannot be restored after reinstall. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
